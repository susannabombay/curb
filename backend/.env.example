# Get a free key at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
DATAMALL_ACCOUNT_KEY=your_key_here

# Signs login tokens -- generate your own, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change_me_to_a_random_value

# Reservation window settings (minutes)
RESERVATION_WINDOW_MIN=15
EXTEND_MIN=10
EXTEND_FEE_CENTS=150
MAX_EXTENDS=1

# Check-in ("I've arrived") rules
CHECKIN_OPENS_BEFORE_MIN=10
ARRIVE_RADIUS_M=300
