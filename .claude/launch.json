{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "curb-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "curb-backend",
      "runtimeExecutable": "backend/venv/bin/uvicorn",
      "runtimeArgs": ["main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
